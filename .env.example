# InvoiceGuard Environment Configuration

# Core App
PROJECT_NAME=InvoiceGuard
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1

# Security & CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database (SQLite default for zero-setup, PostgreSQL ready)
DATABASE_URL=sqlite:///./data/invoiceguard.db

# Storage & Upload Limits
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=15
MAX_PAGES_TO_PROCESS=3

# Extractor Configuration
EXTRACTOR_LLM=0
LLM_API_KEY=
LAYOUTLM_MODEL_ID=
HF_TOKEN=

# Fusion Configuration ("combined" | "baseline")
FUSION_MODE=combined
